// tsconfig.lib.json
{
  "compilerOptions": {
    "declaration": true,
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/lib"],
  "exclude": [
    "src/playground",
    "**/*.stories.tsx",
    "src/test",
    "**/*.test.tsx",
    "node_modules",
    "dist"
  ]
}
